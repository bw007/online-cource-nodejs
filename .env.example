# Google OAuth Configuration
GOOGLE_CLIENT_ID=fake-google-client-id
GOOGLE_CLIENT_SECRET=fake-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend Configuration (for redirects)
FRONTEND_URL=http://localhost:3000

# Session Configuration (if using sessions)
SESSION_SECRET=fake-session-secret

# ======== Database ========
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=debug
MONGODB_URI=mongodb://localhost:27017/fake-db

# ======== Auth ========
JWT_SECRET=fake-jwt-secret
JWT_REFRESH_SECRET=fake-jwt-refresh-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ======== Admin (Auto Create) ========
ADMIN_PASSWORD=fake-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Fake Admin

#========= Swagger ===============
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
SWAGGER_JSON_PATH=/swagger.json
